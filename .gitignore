# ============================================================================
# AI_medical - .gitignore
# ============================================================================

# Environment & secrets
.env
.env.*
!.env.example
*.key
*.pem
*.crt
secrets/
credentials/
*credentials*.json
!credentials.checklist.md

# n8n local data
.n8n/
n8n_data/

# Docker volumes
postgres_data/
redis_data/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Node
node_modules/
dist/
build/

# Python (if any helper scripts)
__pycache__/
*.py[cod]
.venv/
venv/

# Supabase local dev
.supabase/

# Test artifacts
tmp/
.tmp/
coverage/

# Backup dumps
*.sql.bak
*.dump
backups/
