      "name": "Fetch All Active Clinics",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const clinics = $input.all().map(i => i.json);\nconst now = new Date();\n\n// Filter to clinics where local hour is 0 (midnight window 00:00-00:29)\nconst midnightClinics = clinics.filter(c => {\n  try {\n    const localTime = new Date(now.toLocaleString('en-US', { timeZone: c.timezone }));\n    return localTime.getHours() === 0 && localTime.getMinutes() < 30;\n  } catch (e) {\n    return false;\n  }\n});\n\nif (midnightClinics.length === 0) {\n  return []; // No clinics at midnight right now\n}\n\nreturn midnightClinics.map(c => ({json: c}));"
      },
      "id": "6312107c-af64-4a78-bf38-b1908f7062a2",
      "name": "Filter Clinics at Midnight",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        690,
        300
      ]
    },
