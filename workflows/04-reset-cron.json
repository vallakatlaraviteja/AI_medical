      "id": "1217f279-55a9-4ecc-85b2-f5149868780c",
      "name": "Supabase Keepalive Ping",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1570,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Light CPU computation to prevent Oracle free-tier VM idle reclamation\n// Calculate primes up to 500K as a keepalive workload\nfunction sieve(limit) {\n  const arr = new Array(limit + 1).fill(true);\n  arr[0] = arr[1] = false;\n  for (let i = 2; i <= Math.sqrt(limit); i++) {\n    if (arr[i]) {\n      for (let j = i * i; j <= limit; j += i) {\n        arr[j] = false;\n      }\n    }\n  }\n  return arr.filter(Boolean).length;\n}\n\nconst primeCount = sieve(500000);\nreturn [{json: { heartbeat: true, primes_computed: primeCount, timestamp: new Date().toISOString() }}];"
      },
      "id": "1e8a9eac-e7da-480a-9645-af57e6023d2c",
      "name": "Oracle VM Anti-Idle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1790,
        300
      ]
    }
