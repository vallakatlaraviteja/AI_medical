        "url": "={{$env.SUPABASE_URL}}/rest/v1/idempotency_keys",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
