      ],
      "webhookId": "f7a8b9c0-d1e2-4f3a-5b6c-7d8e9f0a1b2c"
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst items = $input.all();\nconst inputData = items[0].json;\n\n// --- Handle Meta GET verification challenge ---\nconst query = inputData.query || {};\nif (query['hub.mode'] === 'subscribe') {\n  if (query['hub.verify_token'] === $env.META_WHATSAPP_VERIFY_TOKEN) {\n    return [{ json: { response: query['hub.challenge'] } }];\n  }\n  throw new Error('Webhook verification failed');\n}\n\n// --- HMAC-SHA256 signature validation ---\nconst signature = inputData.headers['x-hub-signature-256'];\nconst rawBody = JSON.stringify(inputData.body);\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.META_APP_SECRET)\n  .update(rawBody)\n  .digest('hex');\n\nif (signature !== expected) {\n  throw new Error('Invalid webhook signature');\n}\n\n// --- Extract text message ---\nconst entry = inputData.body?.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\n\nif (!message || message.type !== 'text') {\n  return [];\n}\n\nreturn [{\n  json: {\n    message_id: message.id,\n    patient_phone: message.from,\n    patient_message: message.text.body,\n    phone_number_id: change.metadata.phone_number_id,\n    timestamp: message.timestamp\n  }\n}];"
      },
      "id": "a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Verify Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/clinics?whatsapp_phone_number_id=eq.{{ $json.phone_number_id }}&is_active=eq.true&select=clinic_id",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}"
            },
