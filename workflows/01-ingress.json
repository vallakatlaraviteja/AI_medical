      "id": "30a3513b-6395-487a-8f5c-c96be0ceac2b",
      "name": "Idempotency Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        910,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "// Check if idempotency insert returned 409 (duplicate)\nconst statusCode = $input.first().json.statusCode || $input.first().json.responseStatusCode;\nif (statusCode === 409) {\n  return []; // Already processed \u2014 stop silently\n}\n\n// Rate limiter: count messages in last 5 minutes\nconst supabaseUrl = $env.SUPABASE_URL;\nconst serviceKey = $env.SUPABASE_SERVICE_ROLE_KEY;\nconst clinicId = $json.clinic_id;\nconst patientPhone = $json.patient_phone;\n\nconst fiveMinAgo = new Date(Date.now() - 5 * 60 * 1000).toISOString();\nconst countUrl = `${supabaseUrl}/rest/v1/conversations?clinic_id=eq.${clinicId}&patient_phone=eq.${patientPhone}&created_at=gte.${fiveMinAgo}&select=conversation_id`;\n\nconst response = await fetch(countUrl, {\n  headers: {\n    'apikey': serviceKey,\n    'Authorization': `Bearer ${serviceKey}`,\n    'Prefer': 'count=exact'\n  }\n});\n\nconst countHeader = response.headers.get('content-range');\nconst count = countHeader ? parseInt(countHeader.split('/')[1] || '0') : 0;\n\nif (count >= 10) {\n  return [{json: {\n    rate_limited: true,\n    safe_message: \"Apologies, please slow down. Your messages are arriving too quickly. Try again in a few minutes.\",\n    patient_phone: patientPhone,\n    phone_number_id: $json.phone_number_id\n  }}];\n}\n\nreturn [{json: {\n  rate_limited: false,\n  message_id: $json.message_id,\n  clinic_id: clinicId,\n  patient_phone: patientPhone,\n  patient_message: $json.patient_message,\n  phone_number_id: $json.phone_number_id,\n  timestamp: $json.timestamp\n}}];"
      },
      "id": "2fa99efe-9a87-4489-b05f-9f2c52898ed0",
      "name": "Rate Limiter",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1130,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.rate_limited}}",
              "value2": true
            }
          ]
        }
      },
      "id": "e6f21cba-ddf1-423c-b04e-b4b2f1824060",
      "name": "IF Rate Limited",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1350,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "let msg = $json.patient_message;\n\n// Strip control characters (keep newlines)\nmsg = msg.replace(/[\\x00-\\x09\\x0b-\\x1f]/g, '');\n\n// Cap at 2000 characters\nmsg = msg.substring(0, 2000);\n\n// Check prompt injection patterns\nconst injectionPatterns = [\n  /ignore (all|previous) instructions/i,\n  /you are now/i,\n  /system prompt/i,\n  /reveal your instructions/i,\n  /forget everything/i,\n  /new persona/i\n];\n\nconst isInjection = injectionPatterns.some(p => p.test(msg));\n\nif (isInjection) {\n  return [{json: {\n    injection_blocked: true,\n    safe_message: \"I'm sorry, I had trouble processing that. Could you please rephrase your question? Our team is here to help you book an appointment.\",\n    patient_phone: $json.patient_phone,\n    phone_number_id: $json.phone_number_id\n  }}];\n}\n\nreturn [{json: {\n  injection_blocked: false,\n  sanitized_message: msg,\n  message_id: $json.message_id,\n  clinic_id: $json.clinic_id,\n  patient_phone: $json.patient_phone,\n  phone_number_id: $json.phone_number_id,\n  timestamp: $json.timestamp\n}}];"
      },
      "id": "0be6809f-3973-4796-9bc4-ed3313a42598",
      "name": "Input Sanitizer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
