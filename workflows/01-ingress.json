    {
      "parameters": {
        "jsCode": "let msg = $json.patient_message;\n\nmsg = msg.replace(/[\\x00-\\x09\\x0b-\\x1f]/g, '');\nmsg = msg.substring(0, 2000);\n\nconst injectionPatterns = [\n  /ignore (all|previous) instructions/i,\n  /you are now/i,\n  /system prompt/i,\n  /reveal your instructions/i,\n  /forget everything/i,\n  /new persona/i\n];\n\nif (injectionPatterns.some(p => p.test(msg))) {\n  return [{\n    json: {\n      ...$json,\n      injection_blocked: true,\n      safe_message: \"I'm sorry, I had trouble processing that. Could you please rephrase your question? Our team is here to help you book an appointment.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...$json,\n    injection_blocked: false,\n    sanitized_message: msg\n  }\n}];"
      },
