{
  "name": "WF-1 WhatsApp Ingress",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "webhook/whatsapp",
        "responseMode": "onReceived",
        "responseCode": 200,
        "options": {}
      },
      "id": "55fec7fb-6044-4879-b7c8-cffaeb9fa7fa",
      "name": "WhatsApp Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const crypto = require('crypto');\n\n// Handle Meta verification GET challenge\nconst method = $input.first().json.headers?.method || 'POST';\nif (method === 'GET') {\n  const mode = $input.first().json.query?.['hub.mode'];\n  const token = $input.first().json.query?.['hub.verify_token'];\n  const challenge = $input.first().json.query?.['hub.challenge'];\n  if (mode === 'subscribe' && token === $env.META_WHATSAPP_VERIFY_TOKEN) {\n    return [{json: {response: challenge}}];\n  }\n  throw new Error('Webhook verification failed');\n}\n\n// Verify X-Hub-Signature-256\nconst signature = $input.first().json.headers['x-hub-signature-256'];\nconst body = JSON.stringify($input.first().json.body);\nconst expected = 'sha256=' + crypto.createHmac('sha256', $env.META_APP_SECRET).update(body).digest('hex');\nif (signature !== expected) {\n  throw new Error('Invalid webhook signature');\n}\n\n// Extract message data\nconst entry = $input.first().json.body.entry?.[0];\nconst change = entry?.changes?.[0]?.value;\nconst message = change?.messages?.[0];\nif (!message || message.type !== 'text') {\n  return []; // skip non-text messages\n}\n\nreturn [{json: {\n  message_id: message.id,\n  patient_phone: message.from,\n  patient_message: message.text.body,\n  phone_number_id: change.metadata.phone_number_id,\n  timestamp: message.timestamp\n}}];"
      },
      "id": "ccbd3f87-6074-423b-9a59-657c1d6a41bc",
      "name": "Verify Webhook Signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/clinics?whatsapp_phone_number_id=eq.{{$json.phone_number_id}}&is_active=eq.true&select=clinic_id&limit=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
