    {
      "parameters": {
        "jsCode": "const prev = $('Verify Signature').first().json;\nconst clinicResult = $input.first().json;\n\nif (!clinicResult || !clinicResult.clinic_id) {\n  throw new Error('No active clinic found for this phone_number_id');\n}\n\nreturn [{\n  json: {\n    ...prev,\n    clinic_id: clinicResult.clinic_id\n  }\n}];"
      },
