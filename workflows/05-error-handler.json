{
  "name": "WF-5 Error Handler + Dead Letter Queue",
  "nodes": [
    {
      "parameters": {},
      "id": "fae25ffb-1761-493a-a8af-e9fddd87ef8b",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const error = $input.first().json;\nconst errorMsg = error.execution?.error?.message || error.message || 'Unknown error';\nconst workflowName = error.workflow?.name || 'Unknown';\nconst nodeName = error.execution?.lastNodeExecuted || 'Unknown';\nconst clinicId = error.execution?.data?.clinic_id || null;\nconst patientPhone = error.execution?.data?.patient_phone || null;\nconst phoneNumberId = error.execution?.data?.phone_number_id || null;\n\n// Classify error\nconst recoverablePatterns = [/timeout/i, /5\\d{2}/, /429/, /ECONNREFUSED/i, /ETIMEDOUT/i, /socket hang up/i];\nconst isRecoverable = recoverablePatterns.some(p => p.test(errorMsg));\n\nreturn [{json: {\n  error_message: errorMsg,\n  workflow_name: workflowName,\n  node_name: nodeName,\n  clinic_id: clinicId,\n  patient_phone: patientPhone,\n  phone_number_id: phoneNumberId,\n  is_recoverable: isRecoverable,\n  timestamp: new Date().toISOString(),\n  original_data: error.execution?.data || {}\n}}];"
      },
      "id": "bacbe0be-5b1a-425e-b3ad-93f710a540b3",
      "name": "Classify Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$json.is_recoverable}}",
              "value2": true
            }
          ]
        }
      },
      "id": "2834cb70-5b38-4a7a-8bb6-fcc29c7e3b98",
      "name": "IF Recoverable",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        690,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/dead_letter_queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"clinic_id\": \"{{$json.clinic_id}}\", \"workflow_name\": \"{{$json.workflow_name}}\", \"payload\": {{JSON.stringify($json.original_data)}}, \"error_message\": \"{{$json.error_message}}\", \"retry_count\": 0, \"max_retries\": 3, \"status\": \"pending\"}"
      },
      "id": "1458bf18-9edc-4441-9215-4fafc97467cd",
      "name": "Push to DLQ (Recoverable)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        910,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v19.0/{{$json.phone_number_id}}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.META_WHATSAPP_ACCESS_TOKEN}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"messaging_product\": \"whatsapp\", \"to\": \"{{$json.patient_phone}}\", \"type\": \"text\", \"text\": {\"body\": \"Hi! We received your message but had a brief technical issue. We're working on it and will get back to you shortly. If urgent, please call us directly.\"}}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "76486e65-a564-4d86-9ca7-8e0950f7abe4",
      "name": "Send Patient Fallback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1130,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{$env.TELEGRAM_ADMIN_BOT_TOKEN}}/sendMessage",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"chat_id\": \"{{$env.TELEGRAM_ADMIN_CHAT_ID}}\", \"text\": \"\ud83d\udea8 FATAL ERROR in {{$json.workflow_name}}\\n\\nClinic: {{$json.clinic_id}}\\nNode: {{$json.node_name}}\\nError: {{$json.error_message}}\\nTime: {{$json.timestamp}}\\n\\nManual intervention required.\", \"parse_mode\": \"HTML\"}"
      },
      "id": "3badbdc1-304d-439a-974e-f18a109fee66",
      "name": "Fatal Error - Alert Admin",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        910,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/dead_letter_queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"clinic_id\": \"{{$json.clinic_id}}\", \"workflow_name\": \"{{$json.workflow_name}}\", \"payload\": {{JSON.stringify($json.original_data)}}, \"error_message\": \"FATAL: {{$json.error_message}}\", \"status\": \"exhausted\", \"retry_count\": 99}"
      },
      "id": "5c72b2ef-28ae-4ec5-b8d0-15bcd8660f06",
      "name": "Log Fatal to DLQ (exhausted)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1130,
        450
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "7047f282-4e93-4b9b-94a8-39fd3ca7c373",
      "name": "DLQ Retry Trigger (Cron)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        250,
        650
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/dead_letter_queue?status=eq.pending&next_retry_at=lte.now()&order=next_retry_at.asc&limit=10",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.SUPABASE_SERVICE_ROLE_KEY}}"
            }
          ]
        },
        "options": {}
      },
      "id": "22851ede-a962-4399-9adf-7f1aa8e4b26d",
      "name": "Fetch Pending DLQ Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        470,
        650
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "c9f5abfa-005b-4024-80a0-0a656fb919c6",
      "name": "Process Each DLQ Item",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        690,
        650
      ]
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const supabaseUrl = $env.SUPABASE_URL;\nconst key = $env.SUPABASE_SERVICE_ROLE_KEY;\nconst item = $json;\n\n// Mark as processing\nawait fetch(`${supabaseUrl}/rest/v1/dead_letter_queue?dlq_id=eq.${item.dlq_id}`, {\n  method: 'PATCH',\n  headers: { 'apikey': key, 'Authorization': `Bearer ${key}`, 'Content-Type': 'application/json' },\n  body: JSON.stringify({ status: 'processing' })\n});\n\n// Attempt re-execution by triggering the original workflow\n// Note: In production, this would use n8n's internal API to re-execute\n// For now, we increment retry_count and apply exponential backoff\nconst newRetryCount = (item.retry_count || 0) + 1;\n\nif (newRetryCount >= (item.max_retries || 3)) {\n  // Exhausted - mark as failed\n  await fetch(`${supabaseUrl}/rest/v1/dead_letter_queue?dlq_id=eq.${item.dlq_id}`, {\n    method: 'PATCH',\n    headers: { 'apikey': key, 'Authorization': `Bearer ${key}`, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ status: 'exhausted', retry_count: newRetryCount })\n  });\n\n  // Alert admin\n  await fetch(`https://api.telegram.org/bot${$env.TELEGRAM_ADMIN_BOT_TOKEN}/sendMessage`, {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({ chat_id: $env.TELEGRAM_ADMIN_CHAT_ID, text: `\\u26a0 DLQ item exhausted after ${newRetryCount} retries\\nWorkflow: ${item.workflow_name}\\nClinic: ${item.clinic_id}\\nError: ${item.error_message}` })\n  });\n} else {\n  // Exponential backoff: 5min * 2^retry_count\n  const backoffMinutes = 5 * Math.pow(2, newRetryCount);\n  const nextRetry = new Date(Date.now() + backoffMinutes * 60000).toISOString();\n\n  await fetch(`${supabaseUrl}/rest/v1/dead_letter_queue?dlq_id=eq.${item.dlq_id}`, {\n    method: 'PATCH',\n    headers: { 'apikey': key, 'Authorization': `Bearer ${key}`, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ status: 'pending', retry_count: newRetryCount, next_retry_at: nextRetry })\n  });\n}\n\nreturn [{json: { dlq_id: item.dlq_id, retry_count: newRetryCount, status: newRetryCount >= (item.max_retries || 3) ? 'exhausted' : 'pending' }}];"
      },
      "id": "c7090fc2-2dbe-4929-80a7-146c97c9a39b",
      "name": "Retry Execution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        910,
        650
      ]
    }
  ],
