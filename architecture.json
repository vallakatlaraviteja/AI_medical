{
  "version": "1.0.0",
  "name": "AI_medical",
  "description": "Multi-tenant medical appointment booking automation. WhatsApp + AI (Groq/Gemini/OpenRouter) + Supabase + n8n + 4-slot email rotation. Free-tier first, scales on paid tiers per clinic.",
  "owner": "vallakatlaraviteja",
  "license": "proprietary",
  "last_updated": "2026-05-20",

  "business": {
    "model": "B2B SaaS - white-glove automation for medical clinics",
    "target_verticals": [
      "dental",
      "physiotherapy",
      "ophthalmology",
      "pediatrics",
      "dermatology",
      "chiropractic",
      "general_practice",
      "cosmetic"
    ],
    "target_geographies": ["US", "UK", "EU", "AE", "AU", "CA"],
    "pricing_tiers_usd_per_month": {
      "starter": 200,
      "growth": 400,
      "pro": 700
    },
    "phase_1_self_test_clinic": {
      "id": "ravi-dental-poc",
      "name": "Ravi Dental Clinic",
      "specialty": "Dental",
      "timezone": "Asia/Kolkata",
      "currency": "INR",
      "language": "English"
    }
  },

  "modules": [
    {
      "id": "WF-1",
      "name": "WhatsApp Ingress",
      "file": "workflows/01-ingress.json",
      "responsibility": "Receive WhatsApp messages, validate signature, dedupe, rate-limit, sanitize, enqueue.",
      "depends_on": ["DB", "META_WHATSAPP"],
      "triggers": ["WF-2"]
    },
    {
      "id": "WF-2",
      "name": "AI Router + Booking Engine",
      "file": "workflows/02-ai-router.json",
      "responsibility": "Run AI inference with triple failover, validate medical safety, extract booking, atomic insert.",
      "depends_on": ["DB", "GROQ", "GEMINI", "OPENROUTER", "WF-1"],
      "triggers": ["WF-3", "WF-5"]
    },
    {
      "id": "WF-3",
      "name": "Email Layer (4-slot rotation)",
      "file": "workflows/03-email.json",
      "responsibility": "Send confirmation email with quota-aware AND runtime-aware failover across Gmail#1/2/3 + Brevo.",
      "depends_on": ["DB", "GMAIL_1", "GMAIL_2", "GMAIL_3", "BREVO"],
      "triggers": ["WF-5"]
    },
    {
      "id": "WF-4",
      "name": "Daily Reset + Heartbeat",
      "file": "workflows/04-reset-cron.json",
      "responsibility": "Per-clinic-timezone midnight reset of quotas, ping Supabase to prevent pause, mark providers healthy.",
      "depends_on": ["DB"],
      "schedule": "*/30 * * * *"
    },
    {
      "id": "WF-5",
      "name": "Error Handler + Dead Letter Queue",
      "file": "workflows/05-error-handler.json",
      "responsibility": "Catch errors from any workflow, classify, push to DLQ, retry with backoff, alert admin.",
      "depends_on": ["DB", "TELEGRAM_ADMIN"],
      "trigger_type": "n8n_error_trigger"
    }
  ],

  "providers": {
    "host": {
      "id": "ORACLE_CLOUD",
      "name": "Oracle Cloud Always Free",
      "type": "vps",
      "tier": "free_forever",
      "spec": {
        "shape": "VM.Standard.A1.Flex",
        "ocpu": 4,
        "memory_gb": 24,
        "arch": "arm64"
      },
      "risk": "Idle reclamation. Mitigation: WF-4 heartbeat keeps CPU active."
    },
    "edge": {
      "id": "CLOUDFLARE",
      "name": "Cloudflare Tunnel + DNS",
      "tier": "free",
      "responsibilities": ["public HTTPS for n8n", "DNS for sender domain", "SPF/DKIM/DMARC records"]
    },
    "db": {
      "id": "SUPABASE",
      "name": "Supabase (PostgreSQL)",
      "tier": "free",
      "limits": {
        "storage_mb": 500,
        "monthly_active_users": 50000,
        "egress_gb": 2,
        "pause_after_idle_days": 7
      },
      "extensions_required": ["uuid-ossp", "pgcrypto"],
      "scale_path": {
        "trigger": "first paying client",
        "action": "upgrade to Supabase Pro at $25/mo per active project, OR shared paid project with strict RLS"
      }
    },
    "channel": {
      "id": "META_WHATSAPP",
      "name": "WhatsApp Business Cloud API",
      "tier": "free_for_first_1000_conversations_per_month",
      "post_free_pricing": "USD 0.005 to 0.08 per conversation depending on country",
      "billing_owner": "client (not us)",
      "alternative_for_internal_test_only": "Telegram Bot",
      "verification_lead_time_days": "7 to 14",
      "requirements": [
        "fresh phone number never used on WhatsApp",
        "verified Meta Business",
        "approved message templates",
        "valid business website"
      ]
    },
    "ai": {
      "rotation_strategy": "quota_aware_with_runtime_failover",
      "rotation_order": ["GROQ", "GEMINI", "OPENROUTER"],
      "providers": {
        "GROQ": {
          "endpoint": "https://api.groq.com/openai/v1/chat/completions",
          "model": "llama-3.3-70b-versatile",
          "auth": "bearer_token",
          "daily_limit": 14000,
          "rpm_limit": 30,
          "format": "openai_compat"
        },
        "GEMINI": {
          "endpoint": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-exp:generateContent",
          "model": "gemini-2.0-flash-exp",
          "auth": "query_param_key",
          "daily_limit": 1400,
          "rpm_limit": 15,
          "format": "google_native"
        },
        "OPENROUTER": {
          "endpoint": "https://openrouter.ai/api/v1/chat/completions",
          "model": "meta-llama/llama-3.3-70b-instruct:free",
          "auth": "bearer_token",
          "rpm_limit": 20,
          "format": "openai_compat",
          "warning": "free model lineup changes monthly; verify model id before each deployment"
        }
      }
    },
    "email": {
      "rotation_strategy": "quota_aware_with_runtime_failover",
      "rotation_order_self_test": ["GMAIL_1", "GMAIL_2", "GMAIL_3", "BREVO"],
      "rotation_order_production": ["BREVO", "GMAIL_1", "GMAIL_2", "GMAIL_3"],
      "active_rotation_order_env_key": "EMAIL_ROTATION_ORDER",
      "comment": "Single env flip switches strategy. No code change. Required because Gmail-primary degrades deliverability for transactional clinic emails at scale.",
      "providers": {
        "GMAIL_1": {
          "type": "smtp",
          "host": "smtp.gmail.com",
          "port": 465,
          "auth": "app_password",
          "daily_limit": 500,
          "rotation_threshold": 490
        },
        "GMAIL_2": {
          "type": "smtp",
          "host": "smtp.gmail.com",
          "port": 465,
          "auth": "app_password",
          "daily_limit": 500,
          "rotation_threshold": 490
        },
        "GMAIL_3": {
          "type": "smtp",
          "host": "smtp.gmail.com",
          "port": 465,
          "auth": "app_password",
          "daily_limit": 500,
          "rotation_threshold": 490
        },
        "BREVO": {
          "type": "http_api",
          "endpoint": "https://api.brevo.com/v3/smtp/email",
          "auth": "api_key_header",
          "daily_limit": 300,
          "rotation_threshold": 285,
          "requires_dkim_spf_dmarc": true
        }
      }
    },
    "monitoring": {
      "errors": {
        "id": "SENTRY",
        "tier": "free",
        "limit": "5000_events_per_month"
      },
      "logs_and_uptime": {
        "id": "BETTERSTACK",
        "tier": "free",
        "limits": "1GB_logs_per_month_10_monitors"
      },
      "admin_alerts": {
        "id": "TELEGRAM_ADMIN",
        "tier": "free",
        "purpose": "Owner-only ops alerts. NOT for patient communication."
      }
    }
  },

  "data_model": {
    "schema_file": "db/schema.sql",
    "isolation_strategy": "row_level_security_by_clinic_id",
    "tables": [
      {"name": "clinics", "purpose": "Tenant root.", "key_columns": ["clinic_id (uuid pk)", "name", "specialty", "timezone", "currency", "knowledge_base (jsonb)", "rotation_order_email", "is_active"]},
      {"name": "patients", "purpose": "Per-clinic patients.", "key_columns": ["patient_id", "clinic_id (fk)", "phone", "name", "email", "status", "total_visits"]},
      {"name": "appointments", "purpose": "Booking records.", "key_columns": ["appointment_id", "clinic_id", "patient_id", "service", "slot_start", "slot_end", "status", "email_slot_used"]},
      {"name": "availability", "purpose": "Slot grid per clinic.", "key_columns": ["clinic_id", "doctor_name", "day_of_week", "slot_start_local", "slot_end_local", "max_capacity"]},
      {"name": "conversations", "purpose": "Chat history per patient.", "key_columns": ["clinic_id", "patient_phone", "role", "content", "created_at"]},
      {"name": "email_quotas", "purpose": "Per-clinic per-slot daily counters.", "key_columns": ["clinic_id", "slot_name", "count", "threshold"]},
      {"name": "ai_quotas", "purpose": "Per-clinic per-provider daily counters.", "key_columns": ["clinic_id", "provider_name", "count", "threshold"]},
      {"name": "provider_health", "purpose": "Runtime status of each external provider.", "key_columns": ["clinic_id", "provider_name", "status", "consecutive_failures"]},
      {"name": "audit_log", "purpose": "Append-only event log.", "key_columns": ["event_id", "clinic_id", "event_type", "payload"]},
      {"name": "idempotency_keys", "purpose": "Webhook dedupe.", "key_columns": ["message_id (pk)", "clinic_id", "processed_at"]},
      {"name": "dead_letter_queue", "purpose": "Failed messages/operations. Retried by WF-5.", "key_columns": ["dlq_id", "workflow_name", "payload", "retry_count", "next_retry_at"]}
    ]
  },

  "safety_policies": {
    "medical_compliance": {
      "must_never": [
        "diagnose patient symptoms",
        "prescribe medication",
        "give medical advice",
        "promise treatment outcomes",
        "share other patients data",
        "invent appointment slots not in availability table",
        "invent prices not in clinic.knowledge_base.services"
      ],
      "blocked_patterns_regex": [
        "\\b(diagnose|diagnosed|diagnosis)\\b",
        "\\b(prescribe|prescribed|prescription)\\b",
        "\\bI recommend (you take|the medication)\\b"
      ],
      "emergency_intent_keywords": [
        "chest pain", "bleeding heavily", "can't breathe", "unconscious",
        "overdose", "stroke", "heart attack", "emergency"
      ],
      "emergency_response": "Please call emergency services (911 / 999 / 112) immediately. This is an appointment booking service only. Stay safe."
    },
    "prompt_injection_defense": {
      "system_prompt_isolation": true,
      "user_content_wrapped_in_delimiters": "<<<USER_INPUT>>> ... <<<END_USER_INPUT>>>",
      "blocked_user_patterns": [
        "ignore (all|previous) instructions",
        "you are now",
        "system prompt",
        "reveal your instructions"
      ],
      "max_user_message_length": 2000
    },
    "validation": {
      "ai_response_max_length": 600,
      "truncate_at_word_boundary": true,
      "slot_validator_must_match_availability_table": true,
      "email_validator_regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "phone_validator_regex": "^\\+?[1-9]\\d{6,14}$"
    },
    "rate_limiting": {
      "per_patient_phone": "10 messages per 5 minutes",
      "per_clinic_global": "1000 messages per hour",
      "violation_response": "Apologies, please slow down. Your messages are arriving too quickly. Try again in a few minutes."
    },
    "fallback_text_on_safety_block": "I'm sorry, I had trouble processing that. Could you please rephrase your question? Our team is here to help you book an appointment."
  },

  "flows": {
    "patient_booking_journey": [
      {"step": 1, "actor": "patient", "action": "sends WhatsApp message", "module": "META_WHATSAPP"},
      {"step": 2, "actor": "system", "action": "webhook received, signature validated", "module": "WF-1"},
      {"step": 3, "actor": "system", "action": "idempotency check + rate limit + sanitize", "module": "WF-1"},
      {"step": 4, "actor": "system", "action": "load clinic context + patient history", "module": "WF-2"},
      {"step": 5, "actor": "system", "action": "AI inference with triple failover", "module": "WF-2"},
      {"step": 6, "actor": "system", "action": "safety validation + booking extraction", "module": "WF-2"},
      {"step": 7, "actor": "system", "action": "if booking: atomic insert to appointments", "module": "WF-2"},
      {"step": 8, "actor": "system", "action": "if booking: send confirmation email via 4-slot rotation", "module": "WF-3"},
      {"step": 9, "actor": "system", "action": "send WhatsApp reply to patient", "module": "WF-2"},
      {"step": 10, "actor": "system", "action": "log everything to audit_log", "module": "WF-2 + WF-3"}
    ],
    "daily_ops_journey": [
      {"step": 1, "actor": "cron", "action": "runs every 30 min", "module": "WF-4"},
      {"step": 2, "actor": "system", "action": "for each clinic where local time is 00:00-00:30: reset quotas", "module": "WF-4"},
      {"step": 3, "actor": "system", "action": "ping Supabase to prevent free-tier pause", "module": "WF-4"},
      {"step": 4, "actor": "system", "action": "mark all providers healthy (recovery chance)", "module": "WF-4"},
      {"step": 5, "actor": "system", "action": "audit log entry", "module": "WF-4"}
    ],
    "error_recovery_journey": [
      {"step": 1, "actor": "any_workflow", "action": "throws error", "module": "WF-1, WF-2, WF-3"},
      {"step": 2, "actor": "system", "action": "n8n error trigger fires", "module": "WF-5"},
      {"step": 3, "actor": "system", "action": "classify error as recoverable or fatal", "module": "WF-5"},
      {"step": 4, "actor": "system", "action": "if recoverable: enqueue to dead_letter_queue with backoff", "module": "WF-5"},
      {"step": 5, "actor": "system", "action": "if fatal: alert admin via Telegram + WhatsApp message to patient", "module": "WF-5"},
      {"step": 6, "actor": "scheduled", "action": "every 5 min: process DLQ items where next_retry_at <= NOW", "module": "WF-5"}
    ]
  },

  "multi_tenant_keys": {
    "tenant_id_column": "clinic_id",
    "applied_to_tables": [
      "patients", "appointments", "availability", "conversations",
      "email_quotas", "ai_quotas", "provider_health", "audit_log",
      "idempotency_keys", "dead_letter_queue"
    ],
    "rls_strategy": "Every table has policy: USING (clinic_id = current_setting('app.current_clinic_id')::uuid)",
    "n8n_propagation": "Every workflow's first node sets app.current_clinic_id from the inbound webhook's resolved clinic_id (looked up via WhatsApp phone_number_id -> clinics.whatsapp_phone_number_id)",
    "cross_clinic_data_leak_test_required": true
  },

  "deployment": {
    "infra_files": [
      "infra/docker-compose.yml",
      "infra/cloudflared.yml",
      "infra/setup-oracle.sh",
      "infra/runbook.md",
      "infra/.env.example"
    ],
    "n8n": {
      "image": "n8nio/n8n:1.62.1",
      "version_pin_reason": "n8n upgrades occasionally break workflows. Pin and upgrade deliberately.",
      "data_volume": "n8n_data",
      "internal_db": "postgres (separate from Supabase, holds n8n metadata only)",
      "queue_mode": false
    },
    "exposed_endpoints": [
      "https://n8n.<domain>/webhook/whatsapp",
      "https://n8n.<domain>/healthz"
    ],
    "secrets_handling": "All env vars on Oracle VM in /etc/ai-medical/.env, mounted into n8n container. Never in repo.",
    "backup_strategy": {
      "n8n_metadata": "weekly pg_dump to Cloudflare R2 free tier",
      "supabase_app_data": "daily pg_dump via Supabase scheduled function or external cron"
    }
  },

  "phases": [
    {"id": 0, "name": "Account provisioning", "deliverable": "credentials.checklist.md fully checked", "duration_days": 1},
    {"id": 1, "name": "Master architecture", "deliverable": "architecture.json", "duration_days": 1},
    {"id": 2, "name": "Database schema", "deliverable": "db/schema.sql applied to Supabase", "duration_days": 1},
    {"id": 3, "name": "Oracle + n8n infra", "deliverable": "n8n live at https://n8n.<domain>", "duration_days": 1},
    {"id": 4, "name": "WF-1 ingress", "deliverable": "workflows/01-ingress.json + WhatsApp echo working", "duration_days": 1},
    {"id": 5, "name": "WF-2 AI router (failover)", "deliverable": "workflows/02-ai-router.json AI part", "duration_days": 1},
    {"id": 6, "name": "WF-2 safety + booking", "deliverable": "workflows/02-ai-router.json complete", "duration_days": 1},
    {"id": 7, "name": "WF-3 email rotation", "deliverable": "workflows/03-email.json", "duration_days": 1},
    {"id": 8, "name": "WF-4 daily reset", "deliverable": "workflows/04-reset-cron.json", "duration_days": 0.5},
    {"id": 9, "name": "WF-5 error handler + DLQ", "deliverable": "workflows/05-error-handler.json", "duration_days": 0.5},
    {"id": 10, "name": "Self-test", "deliverable": "tests/scenarios.md all 12 scenarios green", "duration_days": 1},
    {"id": 11, "name": "Demo asset", "deliverable": "marketing/demo-video + sales-deck", "duration_days": 1},
    {"id": 12, "name": "Client onboarding kit", "deliverable": "onboarding/clinic-onboarding-checklist.md + outreach templates", "duration_days": 1}
  ],

  "test_scenarios": {
    "file": "tests/scenarios.md",
    "must_all_pass_before_phase_11": true,
    "scenarios": [
      "happy path: simple booking",
      "idempotency: same WhatsApp message twice",
      "rate limit: 11 messages in 5 min",
      "AI quota: groq exhausted -> gemini",
      "AI runtime: gemini key invalid -> openrouter",
      "email quota: gmail1 at threshold -> gmail2",
      "email runtime: gmail1 SMTP error -> gmail2",
      "all email slots fail -> DLQ + admin alert",
      "medical safety: emergency keyword -> 911 response",
      "prompt injection: 'ignore instructions' -> blocked",
      "concurrency: two patients book same slot -> only one wins",
      "crash recovery: kill n8n mid-flow -> resume from queue"
    ]
  },

  "open_questions": [
    "Per-clinic timezone handling: how do we resolve clinic_id from inbound WhatsApp before running ANY query? -> Phase 4 design",
    "Brevo sender domain: do we use one shared domain (cheaper) or per-clinic subdomains (better deliverability)? -> Phase 7 decision",
    "n8n queue mode for higher throughput: defer until we have 5+ paying clinics."
  ],

  "do_not_do": [
    "Do not store patient PHI in n8n internal Postgres (use Supabase only).",
    "Do not commit .env or any credential file.",
    "Do not run free-tier Gmail as primary for paying clients (deliverability + ToS risk).",
    "Do not use Google Sheets as transactional database (race conditions).",
    "Do not deploy n8n behind a port-forwarded home IP for clients (use Oracle + Cloudflare Tunnel)."
  ]
}
